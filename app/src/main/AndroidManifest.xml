<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性过滤：不声明就"看不见"TTS 引擎服务，
         绑定会失败（HyperOS 上表现为 AppsFilter BLOCKED + init status=-1）。
         这是所有 targetSdk 30+ 应用使用 TextToSpeech 的标准要求。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 通知：显示服务运行状态，提供"暂停/恢复"入口 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v2.0 前台服务：常驻监听音量变化触发报时 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 报时期间保持 CPU 唤醒，避免息屏时语音被系统休眠截断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开机后自动拉起报时服务；HyperOS 还需在系统设置允许本应用"自启动" -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v3.5.3 看门狗改用可穿透 Doze 的精确闹钟（夜间息屏数小时仍能自检） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 注意：本应用不申请、也不使用 INTERNET 权限，完全本地运行 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeyTime">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v2.0 核心：前台服务监听音量变化（息屏时）触发报时。
             不依赖无障碍权限——HyperOS 对个人应用的无障碍服务有系统级过滤，
             写入 enabled_accessibility_services 会被同步剥离、服务不进设置列表，
             故 v1.x 的无障碍按键拦截方案在该 ROM 上不可用（详见 README）。 -->
        <service
            android:name=".TimeAnnouncerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="announce_time_on_volume_key_press_while_screen_off" />
        </service>

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- 开机自启：系统启动完成后（及锁定态启动完成）自动拉起报时服务。
             需 RECEIVE_BOOT_COMPLETED 权限；小米/HyperOS 还需在
             设置 → 应用管理 → 按键报时 → 自启动 中允许，否则收不到广播。 -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- v3.5.3：插电 / 应用更新后自动恢复（系统广播，不受隐式广播限制） -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 看门狗（v3.4.3）：AlarmManager 每分钟唤醒，检查报时服务真实存活，
             服务实例被系统杀死（不走 onDestroy、START_STICKY 重启被卡死）时自动拉起。
             不 exported：只接收本应用自己注册的闹钟广播。 -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.keytime.WATCHDOG" />
            </intent-filter>
        </receiver>

        <!-- 定时自动控制（v3.7.0）：系统闹钟到点切换报时状态，穿透 Doze。
             exported=false：只接收本应用的 PendingIntent。 -->
        <receiver
            android:name=".AutoScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.keytime.AUTO_SCHEDULE_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 调试通道：保留用于本机排障（run-as 读 files/debug.log + adb broadcast 控制）。
             仅响应特定 op 动作，均为只读/受控操作，无危险行为。 -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true" />
    </application>
</manifest>
